<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0"
            prefWidth="950.0"
            styleClass="fondo-principal"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.ds.controller.InicioSesionController">

    <stylesheets>
        <URL value="@/org/ds/view/style/iniciosesionview.css"/>
    </stylesheets>

    <children>

        <!-- Panel izquierdo -->
        <VBox prefHeight="600.0"
              prefWidth="430.0"
              spacing="18.0"
              styleClass="panel-informativo">

            <children>

                <Label text="JAVALOGIN"
                       styleClass="logo"/>

                <Label text="Sistema de gestión"
                       styleClass="titulo-panel"/>

                <Label text="Accede a tu espacio de trabajo según el rol asignado."
                       wrapText="true"
                       prefWidth="320.0"
                       styleClass="descripcion-panel"/>

                <VBox spacing="14.0"
                      styleClass="lista-roles">

                    <children>

                        <Label text="✓ Administración de usuarios"
                               styleClass="item-rol"/>

                        <Label text="✓ Panel personalizado para empleados"
                               styleClass="item-rol"/>

                        <Label text="✓ Control de ventas para cajeros"
                               styleClass="item-rol"/>

                        <Label text="✓ Acceso seguro con contraseña cifrada"
                               styleClass="item-rol"/>

                    </children>
                </VBox>

                <Label text="Seguridad • Organización • Productividad"
                       styleClass="texto-inferior"/>

            </children>
        </VBox>

        <!-- Formulario -->
        <VBox layoutX="430.0"
              prefHeight="600.0"
              prefWidth="520.0"
              spacing="16.0"
              styleClass="contenedor-formulario">

            <children>

                <Label text="Iniciar sesión"
                       styleClass="titulo-login"/>

                <Label text="Ingresa tus credenciales para continuar"
                       styleClass="subtitulo-login"/>

                <Label text="Usuario"
                       styleClass="etiqueta"/>

                <TextField fx:id="txtUsuario"
                           promptText="Escribe tu usuario"
                           prefHeight="48.0"
                           prefWidth="340.0"
                           styleClass="campo"/>

                <Label text="Contraseña"
                       styleClass="etiqueta"/>

                <PasswordField fx:id="txtPassword"
                               promptText="Escribe tu contraseña"
                               prefHeight="48.0"
                               prefWidth="340.0"
                               styleClass="campo"
                               onAction="#eventoInicioSesion"/>

                <Label fx:id="lblMensaje"
                       text=""
                       wrapText="true"
                       prefWidth="340.0"
                       styleClass="mensaje"/>

                <Button fx:id="btniniciarSesion"
                        text="Ingresar al sistema"
                        onAction="#eventoInicioSesion"
                        prefHeight="48.0"
                        prefWidth="340.0"
                        defaultButton="true"
                        styleClass="boton-ingresar"/>

                <Label text="El acceso depende del rol registrado en el sistema."
                       wrapText="true"
                       prefWidth="340.0"
                       styleClass="nota"/>

            </children>
        </VBox>

    </children>
</AnchorPane>