<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0"
            prefWidth="950.0"
            styleClass="fondo-principal"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.ds.controller.CajeroDashboardController">

    <stylesheets>
        <URL value="@/org/ds/view/style/cajerodashboardview.css"/>
    </stylesheets>

    <children>

        <VBox prefHeight="600.0"
              prefWidth="230.0"
              spacing="12.0"
              styleClass="menu-lateral">

            <children>

                <Label text="JAVALOGIN"
                       styleClass="logo"/>

                <Label text="CAJERO"
                       styleClass="rol"/>

                <Button text="Inicio"
                        prefWidth="190.0"
                        styleClass="boton-menu-activo"/>

                <Button text="Nueva venta"
                        prefWidth="190.0"
                        styleClass="boton-menu"/>

                <Button text="Historial"
                        prefWidth="190.0"
                        styleClass="boton-menu"/>

                <Button text="Caja"
                        prefWidth="190.0"
                        styleClass="boton-menu"/>

                <Button fx:id="btnSalir"
                        text="Cerrar sesión"
                        onAction="#eventoSalir"
                        prefWidth="190.0"
                        styleClass="boton-salir"/>

            </children>
        </VBox>

        <HBox layoutX="230.0"
              prefHeight="90.0"
              prefWidth="720.0"
              styleClass="encabezado">

            <children>

                <VBox spacing="5.0">

                    <children>

                        <Label text="Panel de cajero"
                               styleClass="titulo"/>

                        <Label fx:id="lblBienvenida"
                               text="Bienvenido cajero"
                               styleClass="bienvenida"/>

                    </children>

                </VBox>

            </children>
        </HBox>

        <VBox layoutX="270.0"
              layoutY="125.0"
              spacing="25.0">

            <children>

                <Label text="Resumen de caja"
                       styleClass="subtitulo"/>

                <HBox spacing="20.0">

                    <children>

                        <VBox prefHeight="135.0"
                              prefWidth="200.0"
                              styleClass="tarjeta">

                            <children>

                                <Label text="Ventas"
                                       styleClass="tarjeta-titulo"/>

                                <Label text="18"
                                       styleClass="tarjeta-numero"/>

                                <Label text="Realizadas hoy"
                                       styleClass="tarjeta-descripcion"/>

                            </children>

                        </VBox>

                        <VBox prefHeight="135.0"
                              prefWidth="200.0"
                              styleClass="tarjeta">

                            <children>

                                <Label text="Ingresos"
                                       styleClass="tarjeta-titulo"/>

                                <Label text="Q 2,450"
                                       styleClass="tarjeta-numero-pequeno"/>

                                <Label text="Total del día"
                                       styleClass="tarjeta-descripcion"/>

                            </children>

                        </VBox>

                        <VBox prefHeight="135.0"
                              prefWidth="200.0"
                              styleClass="tarjeta">

                            <children>

                                <Label text="Estado"
                                       styleClass="tarjeta-titulo"/>

                                <Label text="ABIERTA"
                                       styleClass="tarjeta-estado"/>

                                <Label text="Caja disponible"
                                       styleClass="tarjeta-descripcion"/>

                            </children>

                        </VBox>

                    </children>
                </HBox>

                <VBox prefHeight="190.0"
                      prefWidth="640.0"
                      styleClass="panel-informacion">

                    <children>

                        <Label text="Última operación"
                               styleClass="panel-titulo"/>

                        <Label text="Aquí aparecerá la información de la venta más reciente."
                               styleClass="panel-texto"/>

                    </children>

                </VBox>

            </children>
        </VBox>

    </children>
</AnchorPane>