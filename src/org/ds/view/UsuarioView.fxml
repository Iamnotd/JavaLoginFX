<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0"
            prefWidth="1100.0"
            styleClass="fondo-principal"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.ds.controller.UsuarioController">

    <stylesheets>
        <URL value="@/org/ds/view/style/usuarioview.css"/>
    </stylesheets>

    <children>

        <Label layoutX="45.0"
               layoutY="28.0"
               text="Gestión de usuarios"
               styleClass="titulo-principal"/>

        <Label layoutX="45.0"
               layoutY="64.0"
               text="Registra nuevos usuarios y consulta los accesos existentes."
               styleClass="subtitulo-principal"/>

        <HBox layoutX="45.0"
              layoutY="110.0"
              spacing="25.0">

            <children>

                <!-- Formulario -->

                <VBox prefHeight="430.0"
                      prefWidth="350.0"
                      spacing="13.0"
                      styleClass="tarjeta-formulario">

                    <children>

                        <Label text="Registrar usuario"
                               styleClass="titulo"/>

                        <Label text="Crea un nuevo acceso para el sistema."
                               styleClass="subtitulo"/>

                        <Label text="Nombre de usuario"
                               styleClass="etiqueta"/>

                        <TextField fx:id="txtNuevoUsuario"
                                   promptText="Ejemplo: Carlos"
                                   prefHeight="44.0"
                                   prefWidth="290.0"
                                   styleClass="campo"/>

                        <Label text="Contraseña"
                               styleClass="etiqueta"/>

                        <PasswordField fx:id="txtNuevaPassword"
                                       promptText="Escribe una contraseña"
                                       prefHeight="44.0"
                                       prefWidth="290.0"
                                       styleClass="campo"/>

                        <Label text="Rol"
                               styleClass="etiqueta"/>

                        <ComboBox fx:id="cmbRol"
                                  promptText="Selecciona un rol"
                                  prefHeight="44.0"
                                  prefWidth="290.0"
                                  styleClass="combo"/>

                        <Label fx:id="lblMensajeUsuario"
                               text=""
                               wrapText="true"
                               prefWidth="290.0"
                               styleClass="mensaje"/>

                        <Button text="Registrar usuario"
                                onAction="#eventoRegistrarUsuario"
                                prefHeight="44.0"
                                prefWidth="290.0"
                                styleClass="boton-registrar"/>

                    </children>
                </VBox>

                <!-- Tabla -->

                <VBox prefHeight="430.0"
                      prefWidth="635.0"
                      spacing="12.0"
                      styleClass="tarjeta-tabla">

                    <children>

                        <Label text="Usuarios registrados"
                               styleClass="titulo-tabla"/>

                        <Label text="Listado general de usuarios del sistema."
                               styleClass="subtitulo-tabla"/>

                        <TableView fx:id="tblUsuarios"
                                   prefHeight="340.0"
                                   prefWidth="585.0"
                                   styleClass="tabla-usuarios">

                            <columns>

                                <TableColumn fx:id="colId"
                                             text="ID"
                                             prefWidth="55.0"/>

                                <TableColumn fx:id="colUsername"
                                             text="Usuario"
                                             prefWidth="135.0"/>

                                <TableColumn fx:id="colRol"
                                             text="Rol"
                                             prefWidth="105.0"/>

                                <TableColumn fx:id="colActivo"
                                             text="Activo"
                                             prefWidth="85.0"/>

                                <TableColumn fx:id="colFechaCreacion"
                                             text="Fecha de creación"
                                             prefWidth="200.0"/>

                            </columns>
                        </TableView>

                    </children>
                </VBox>

            </children>
        </HBox>

    </children>
</AnchorPane>