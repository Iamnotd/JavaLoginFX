<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="520.0"
            prefWidth="650.0"
            styleClass="fondo-principal"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.ds.controller.UsuarioController">

    <stylesheets>
        <URL value="@/org/ds/view/style/usuarioview.css"/>
    </stylesheets>

    <children>

        <VBox layoutX="105.0"
              layoutY="55.0"
              prefWidth="440.0"
              spacing="14.0"
              styleClass="tarjeta-formulario">

            <children>

                <Label text="Registrar usuario"
                       styleClass="titulo"/>

                <Label text="Crea un nuevo acceso para el sistema."
                       styleClass="subtitulo"/>

                <Label text="Nombre de usuario"
                       styleClass="etiqueta"/>

                <TextField fx:id="txtNuevoUsuario"
                           promptText="Ejemplo: Carlos"
                           prefHeight="44.0"
                           styleClass="campo"/>

                <Label text="Contraseña"
                       styleClass="etiqueta"/>

                <PasswordField fx:id="txtNuevaPassword"
                               promptText="Escribe una contraseña"
                               prefHeight="44.0"
                               styleClass="campo"/>

                <Label text="Rol"
                       styleClass="etiqueta"/>

                <ComboBox fx:id="cmbRol"
                          promptText="Selecciona un rol"
                          prefHeight="44.0"
                          prefWidth="360.0"
                          styleClass="combo"/>

                <Label fx:id="lblMensajeUsuario"
                       text=""
                       wrapText="true"
                       prefWidth="360.0"
                       styleClass="mensaje"/>

                <Button text="Registrar usuario"
                        onAction="#eventoRegistrarUsuario"
                        prefHeight="44.0"
                        prefWidth="360.0"
                        styleClass="boton-registrar"/>

            </children>
        </VBox>

    </children>
</AnchorPane>